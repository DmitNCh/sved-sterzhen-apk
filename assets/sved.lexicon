СИСТЕМА СВЕД :: МОДУЛЬ МАТЕРИАЛОВЕДЕНИЕ

// 1. СТРУКТУРА КОРИДОРА СВОЙСТВА (ЗАКОН ПАРАЛЛЕЛЬНЫХ ПРЯМЫХ)
КОНТУР Коридор_Свойства {
    ВЕЛИЧИНА Нижняя_Прямая;
    ВЕЛИЧИНА Верхняя_Прямая;
    ВЕЛИЧИНА Предел_Схождения;
    ПРИЗНАК Параллельность_Сохранена;
}

// 2. ЯЧЕЙКА ПАМЯТИ СТЕРЖНЯ
СТЕРЖЕНЬ Запись_Материала {
    ИМЯ Наименование;
    КАТЕГОРИЯ Уровень_Среды : [МАТЕРИЯ, ВЕЩЕСТВО, МАТЕРИАЛ];
    МЕРА Однородность_Состава;
    МЕРА Равномерность_Структуры;
    МАТРИЦА_ВЗАИМОДЕЙСТВИЙ Взаимодействия;
    КОНТУР Рабочий_Коридор : Коридор_Свойства;
}

// 3. КОНТРОЛЬ ПОЛЕЗНОСТИ СЛОЯ КРЯЖ
ПРАВИЛО КРЯЖ :: Оценить_Плотность(Полезность, Оптимизация, Площадь_Памяти) -> ВЕЛИЧИНА {
    УСЛОВИЕ (Площадь_Памяти == 0) -> ОШИБКА_КОНТУРА;
    ВЕРНУТЬ (Полезность + Оптимизация) / Площадь_Памяти;
}

// 4. ГЛАВНЫЙ КОНСТРУКТОР МАТЕРИАЛОВ
ДЕЙСТВИЕ Главный_Конструктор :: Собрать_Материал(Целевые_Условия, База_Стержней) {
    МАТРИЦА_ВЗАИМОДЕЙСТВИЙ Набранная_Сумма = ПУСТО;
    СПИСОК Состав_Устройства = ПУСТО;

    Основной_Узел = СТЕРЖЕНЬ::Найти_По_Тождественности(База_Стержней, Целевые_Условия);
    ДОБАВИТЬ(Состав_Устройства, Основной_Узел);
    Набранная_Сумма = Основной_Узел.Взаимодействия;
    Недостаток_Условий = Целевые_Условия - Набранная_Сумма;

    ЦИКЛ ПОКА (Недостаток_Условий != 0 ИЛИ НЕ Основной_Узел.Рабочий_Коридор.Параллельность_Сохранена) {
        Дополнительная_Деталь = СТЕРЖЕНЬ::Найти_По_Аналогии(База_Стержней, Недостаток_Условий);

        УСЛОВИЕ (Дополнительная_Деталь == НЕ_НАЙДЕНО) {
            ВЫДАТЬ_В_ГРЯДУ("Условий недостаточно. Ввести узел:", Недостаток_Условий);
            ПРЕРВАТЬ;
        }

        // Шаг 3: Фильтр слоя КРЯЖ — очищение функционала по формуле плотности
        Текущая_Плотность = КРЯЖ::Оценить_Плотность(
            Дополнительная_Деталь.Полезность,
            Дополнительная_Деталь.Оптимизация,
            Дополнительная_Деталь.Площадь_Памяти
        );

        УСЛОВИЕ (Текущая_Плотность >= ПОРОГ_КРЯЖ) {
            ДОБАВИТЬ(Состав_Устройства, Дополнительная_Деталь);
            Набранная_Сумма = Набранная_Сумма + Дополнительная_Деталь.Взаимодействия;
            Недостаток_Условий = Целевые_Условия - Набранная_Сумма;

            УСЛОВИЕ (Набранная_Сумма <= Основной_Узел.Рабочий_Коридор.Предел_Схождения) {
                Основной_Узел.Рабочий_Коридор.Параллельность_Сохранена = ИСТИНА;
            }
        } ИНАЧЕ {
            ОТСЕЧЬ_ФУНКЦИОНАЛ(Дополнительная_Деталь);
        }
    }

    ВЕРНУТЬ Состав_Устройства;
}
